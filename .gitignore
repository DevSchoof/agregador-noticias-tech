.venv/

# Cache do Python e do pytest
__pycache__/
*.pyc
.pytest_cache/

# Saídas geradas (mantém só o .gitkeep)
dados/*
!dados/.gitkeep
logs/*
!logs/.gitkeep

# Variáveis de ambiente / segredos
.env

# Editor
.vscode/

